---
import '../styles/global.css';

type Frontmatter = {
	title: string;
	description?: string;
};

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const { title, description } = frontmatter;
const pageTitle = `${title} · Adit Research Labs`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}favicon.png`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex, nofollow" />
		{description && <meta name="description" content={description} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Newsreader:opsz,wght@6..72,300..700&family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
		<title>{pageTitle}</title>
	</head>
	<body class="research-body">
		<div class="research-layout">
			<header class="research-header">
				<p class="research-mark">ARL</p>
				<p class="research-org">Adit Research Labs</p>
			</header>
			<main class="research-main">
				<slot />
			</main>
			<footer class="research-footer">
				<p class="research-status">Status: pre-registration</p>
				<p class="research-year">{year}</p>
			</footer>
		</div>
	</body>
</html>
