---
import BaseLayout from '../layouts/BaseLayout.astro';

type Project = {
	id: string;
	title: string;
	status: string;
	teaser: string;
	paragraphs: string[];
	features?: { heading: string; items: string[] };
	stack?: { heading: string; body: string };
	closer?: string;
};

const projects: Project[] = [
	{
		id: 'orbit',
		title: 'Orbit',
		status: 'Live',
		teaser:
			'Everyone you know, pulled into one enriched graph you can ask questions to in plain english.',
		paragraphs: [
			'the person you need is usually two people away and you have no way to find them. your linkedin export sits unopened, your X follows are something you scroll at 2am, and the guy who used to work at stripe is half a memory. orbit takes that mess and makes it queryable.',
			'it pulls your connections from linkedin and X, then fills each one out into a profile worth searching: headline, current title and company, past roles, location, skills, schools, certifications, languages, follower count, bio. a csv row goes in and a person with a history comes out.',
			'after that you type what you want. "founders who have shipped AI products", "people who worked at google", "engineers in bangalore", "anyone in fintech who also knows someone in mumbai". gemini gets the query plus a compressed version of your graph and hands back ranked people with the reason each one surfaced, so you can tell whether the match came from a job title, an old position, a skill, or one line buried in a bio.',
		],
		features: {
			heading: 'what it does',
			items: [
				'ingest from linkedin and X, or a raw csv or json if you would rather bring your own dump',
				'enrichment that fills in job history, skills, schools, certs, languages, and location',
				'plain english search across your own graph, with the reason for every match',
				'warm paths, so you can see who introduces you instead of sending a cold dm',
				'a globe built with d3 and topojson showing where your network physically lives. mine turned out to be three cities and a rounding error',
				'dashboards for industry, seniority, geography, and skill frequency',
				'conflict resolution for when the same person shows up twice holding two different jobs',
				'roast mode, which reads your stats and tells you how dull your network is. mine got compared to a linkedin comment section',
			],
		},
		stack: {
			heading: 'architecture',
			body: 'react 19 and typescript on vite. zustand with a persist layer keeps the graph in your browser, papaparse handles imports, gemini runs search and roast, d3 and topojson draw the globe, recharts covers the dashboards, framer motion moves things around, react router holds the pages together. no server ever sees your contacts.',
		},
		closer:
			'happenstance charges for a version of this. i wanted the useful half: multi source ingest, semantic search over people, visible match reasoning, warm intros. paying rent on my own address book felt stupid.',
	},
	{
		id: 'veil',
		title: 'Veil',
		status: 'Live',
		teaser:
			'An invisible desktop overlay that reads your screen, hears your calls, and keeps all of it on your machine.',
		paragraphs: [
			'an ai layer that sits over whatever you are already doing. one keystroke brings it up, you ask about what is on screen, you get an answer, it disappears. no window juggling, no pasting screenshots into a chat tab.',
			'three modes. ask grabs a screenshot and streams an answer about it. listen captures system audio, runs speech to text, and can answer while things are still happening, which is the whole point during a call or a lecture. knowledge embeds your notes and documents locally, then injects the relevant chunks into the prompt so replies land in your context instead of the general one.',
		],
		stack: {
			heading: 'architecture',
			body: 'tauri, so a rust core with a react frontend in a native webview. small binary, and the overlay is quick enough to feel like part of the os. state lives in a local sqlite file and your api keys never leave the machine. global shortcuts cover show and hide, dashboard, screenshot, push to talk, and audio listen.',
		},
		closer:
			'it started as a fork of pluely 0.1.9 under gpl 3.0. upstream locked part of the ui behind a license server, so i kept bring your own keys and local storage, opened up the rest, and shipped it. half the tools in this category would rather hold your keys for you.',
	},
	{
		id: 'qr-gpt',
		title: 'A GPT inside a QR',
		status: 'Live',
		teaser:
			'A full transformer, training and inference included, folded into a QR code you can scan with your phone.',
		paragraphs: [
			'karpathy posted a tiny gpt and it was not minified, which felt like an invitation. i squeezed it down, then kept squeezing until the whole thing fit inside a qr code. scan it and a model starts training in your browser.',
			'thirty nine lines of javascript, no dependencies. inside those lines: a hand rolled autograd engine, four head attention, a feed forward mlp with a gelu approximation, adamw on a cosine schedule, both the training and inference loops, and a seeded xoshiro128 prng so runs reproduce. one layer, embedding width 16, context length 8, mlp width 64, 4,064 parameters.',
			'delivery is the fun part. the html payload gets gzipped, base64 encoded, and packed into a version 40-L qr code at 2,953 bytes. the browser runs its own DecompressionStream to unpack it, renders the page, and starts training. nothing to install, no server, no download. an earlier python version is 64 lines and still sits in legacy.',
		],
		closer:
			'this one is closer to a dare than a product. i keep it around because it shows where the floor actually is.',
	},
];
---

<BaseLayout
	frontmatter={{
		title: 'Experiments',
		description: 'Things Adit is building (or about to).',
	}}
>
	<h1>Experiments</h1>
	<p class="exp-intro">side projects that occasionally get out of the house. click a card to open it.</p>

	<h2 class="exp-group-label">Active projects</h2>

	<ul class="exp-list">
		{projects.map((p) => (
			<li class="exp-card" data-card={p.id}>
				<button type="button" class="exp-trigger" aria-expanded="false" aria-controls={`panel-${p.id}`}>
					<span class="exp-head">
						<span class="exp-title">{p.title}</span>
						<span class="exp-status">{p.status}</span>
					</span>
					<span class="exp-teaser">{p.teaser}</span>
					<span class="exp-cue">
						<span class="exp-cue-open">open experiment</span>
						<span class="exp-cue-close">close</span>
						<span class="exp-cue-arrow" aria-hidden="true">→</span>
					</span>
				</button>
				<div class="exp-body" id={`panel-${p.id}`} role="region" aria-label={`${p.title} details`}>
					<div class="exp-body-inner">
						{p.paragraphs.map((text) => <p>{text}</p>)}
						{p.features && (
							<>
								<h3 class="exp-sub">{p.features.heading}</h3>
								<ul class="exp-features">
									{p.features.items.map((item) => <li>{item}</li>)}
								</ul>
							</>
						)}
						{p.stack && (
							<>
								<h3 class="exp-sub">{p.stack.heading}</h3>
								<p>{p.stack.body}</p>
							</>
						)}
						{p.closer && <p class="exp-closer">{p.closer}</p>}
					</div>
				</div>
			</li>
		))}
	</ul>

	<p class="exp-outro">
		more as they go from idea to repo to slightly less embarrassing. some of these will age badly and i will leave them up anyway.
	</p>

	<script>
		(() => {
			const cards = Array.from(document.querySelectorAll('.exp-card'));
			if (!cards.length) return;

			const setOpen = (card, open) => {
				card.classList.toggle('is-open', open);
				card.querySelector('.exp-trigger')?.setAttribute('aria-expanded', open ? 'true' : 'false');
			};

			const closeAll = () => cards.forEach((card) => setOpen(card, false));

			cards.forEach((card) => {
				card.querySelector('.exp-trigger')?.addEventListener('click', () => {
					const wasOpen = card.classList.contains('is-open');
					closeAll();
					if (wasOpen) return;
					setOpen(card, true);
					requestAnimationFrame(() => {
						card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					});
				});
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') closeAll();
			});
		})();
	</script>

	<style>
		.exp-intro,
		.exp-outro {
			color: var(--color-text-muted);
		}

		.exp-group-label {
			font-family: var(--font-mono);
			font-size: 1rem;
			letter-spacing: 0.02em;
			color: var(--color-text);
			margin: var(--space-lg) 0 var(--space-md);
			font-weight: 500;
		}

		.exp-list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: grid;
			gap: var(--space-md);
		}

		.exp-card {
			margin: 0;
			border: 1px solid var(--color-text);
			border-radius: 2px;
			background: color-mix(in srgb, #fff 55%, var(--color-bg));
			box-shadow: 4px 4px 0 color-mix(in srgb, var(--color-text) 88%, transparent);
			transition: background 200ms ease, box-shadow 160ms ease, transform 160ms ease;
		}

		.exp-card:hover {
			background: color-mix(in srgb, #9db388 34%, var(--color-bg));
		}

		.exp-card.is-open {
			background: color-mix(in srgb, #9db388 34%, var(--color-bg));
			box-shadow: 6px 6px 0 color-mix(in srgb, var(--color-text) 88%, transparent);
		}

		.exp-trigger {
			appearance: none;
			width: 100%;
			display: grid;
			gap: var(--space-sm);
			padding: var(--space-md);
			border: 0;
			background: transparent;
			text-align: left;
			cursor: pointer;
			color: inherit;
			font: inherit;
		}

		.exp-trigger:focus-visible {
			outline: 2px solid color-mix(in srgb, var(--color-text) 55%, transparent);
			outline-offset: -4px;
		}

		.exp-head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: var(--space-sm);
		}

		.exp-title {
			font-family: var(--font-mono);
			font-size: 1.05rem;
			font-weight: 500;
			letter-spacing: -0.01em;
		}

		.exp-status {
			font-family: var(--font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: color-mix(in srgb, var(--color-text) 70%, transparent);
			white-space: nowrap;
		}

		.exp-teaser {
			color: color-mix(in srgb, var(--color-text) 72%, transparent);
			font-size: 1rem;
			line-height: 1.55;
		}

		.exp-cue {
			font-family: var(--font-mono);
			font-size: 0.875rem;
			color: var(--color-text);
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
		}

		.exp-cue-close {
			display: none;
		}

		.is-open .exp-cue-open {
			display: none;
		}

		.is-open .exp-cue-close {
			display: inline;
		}

		.exp-cue-arrow {
			transition: transform 200ms ease;
		}

		.is-open .exp-cue-arrow {
			transform: rotate(-90deg);
		}

		.exp-body {
			display: grid;
			grid-template-rows: 0fr;
			transition: grid-template-rows 300ms ease;
		}

		.exp-body-inner {
			min-height: 0;
			overflow: hidden;
			padding: 0 var(--space-md);
		}

		.is-open .exp-body {
			grid-template-rows: 1fr;
		}

		.is-open .exp-body-inner {
			border-top: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);
		}

		.exp-body-inner p {
			margin: var(--space-md) 0;
		}

		.exp-sub {
			font-family: var(--font-mono);
			font-size: 0.78rem;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: color-mix(in srgb, var(--color-text) 62%, transparent);
			margin: var(--space-md) 0 var(--space-sm);
			font-weight: 500;
		}

		.exp-features {
			margin: 0 0 var(--space-md);
			padding-left: 1.15rem;
		}

		.exp-features li {
			margin-bottom: var(--space-xs);
		}

		.exp-closer {
			color: color-mix(in srgb, var(--color-text) 72%, transparent);
			padding-bottom: var(--space-xs);
		}

		@media (prefers-reduced-motion: reduce) {
			.exp-body,
			.exp-card,
			.exp-cue-arrow {
				transition: none;
			}
		}

		@media (max-width: 34rem) {
			.exp-card {
				box-shadow: 3px 3px 0 color-mix(in srgb, var(--color-text) 88%, transparent);
			}

			.exp-head {
				flex-wrap: wrap;
			}
		}
	</style>
</BaseLayout>
